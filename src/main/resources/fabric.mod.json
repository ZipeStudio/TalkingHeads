{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/${mod_slug}",
        "sources": "https://github.com/ZipeStudio/${mod_slug}",
        "issues": "https://github.com/ZipeStudio/${mod_slug}/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "Telegram": "https://t.me/zipeleaf",
                "Me in Discord": "https://discord.com/users/339471364312530945",
                "Discord Mods Team": "https://discord.gg/XmGF7rkkuY"
            }
        }
    },
    "license": "${mod_license}",
    "icon": "icon/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "me.zipestudio.talkingheads.entrypoint.CommonEntrypoint"
        ],
        "client": [
            "me.zipestudio.talkingheads.entrypoint.ClientEntrypoint"
        ],
        "modmenu": [
            "me.zipestudio.talkingheads.utils.modmenu.ModMenuIntegration"
        ],
        "voicechat": [
            "me.zipestudio.talkingheads.client.SimpleVoiceAddon"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": ">=${minecraft}",
        "java": ">=${java}",
        "${fabric_api_id}": "*"
    },
    "accessWidener": "${fabric_trick_accesswidener_id}",
    "mixins": [
        "${fabric_trick_mixin_configs}"
    ]
}